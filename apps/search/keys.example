# One line per provider; a provider is only used when its line has a value.
# search.py reads this file on every request, so an edit is live immediately and
# `sudo systemctl restart search-api` is not needed. Free allowances as of
# November 2026, none of them needing a card:
#
#   TAVILY_API_KEY    https://app.tavily.com                1000 credits/month
#   EXA_API_KEY       https://dashboard.exa.ai/api-keys     $10 of credit/month,
#                                                           resets monthly
#   TINYFISH_API_KEY  https://agent.tinyfish.ai/api-keys    12,000 requests/day
#
# The key stays out of the nix store because this file is read at run time.
TAVILY_API_KEY=
EXA_API_KEY=
TINYFISH_API_KEY=
