--- a/arch/x86/Makefile
+++ b/arch/x86/Makefile
@@ -168,6 +168,11 @@
         # generate_rust_target.rs handles Rust APX gating.
         KBUILD_RUSTFLAGS += -Ctarget-cpu=native
 else
-        KBUILD_CFLAGS += -march=x86-64 -mtune=generic
+        # Tuned for the laptop this kernel runs on (i9-9980HK, Coffee Lake).
+        # A fixed -march is deterministic on any build host, unlike
+        # CONFIG_X86_NATIVE_CPU which sniffs the builder's CPU and would
+        # produce same-store-path/different-bytes poison between CI (AMD)
+        # and the laptop. Do not re-enable NATIVE_CPU.
+        KBUILD_CFLAGS += -march=skylake -mtune=skylake
         KBUILD_RUSTFLAGS += -Ctarget-cpu=x86-64 -Ztune-cpu=generic
 endif
